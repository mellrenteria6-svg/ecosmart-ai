{
  "name": "ecosmart-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:bd": "vite --mode servidor",
    "build:bd": "tsc -b && vite build --mode servidor",
    "servidor": "tsx --env-file=server/.env server/index.ts",
    "servidor:dev": "tsx watch --env-file=server/.env server/index.ts",
    "typecheck:servidor": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/qrcode": "^1.5.6",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
