{
  "name": "ecosmart-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:bd": "vite --mode servidor",
    "build:bd": "tsc -b && vite build --mode servidor",
    "servidor": "tsx --env-file=server/.env server/index.ts",
    "servidor:dev": "tsx watch --env-file=server/.env server/index.ts",
    "typecheck:servidor": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run lint && npm run typecheck:servidor && npm test && npm run build",
    "db:migrar": "tsx --env-file=server/.env server/migrar.ts",
    "ia:embeddings": "tsx scripts/generar-embeddings-ia.ts",
    "ia:evaluar": "tsx scripts/evaluar-ia.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/qrcode": "^1.5.6",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
